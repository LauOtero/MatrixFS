# MatrixFS «ATLAS» — artefactos de build y material sensible

# Compilación / enlazado
*.o
*.a
*.obj
*.exe
*.elf
*.bin
*.hex
*.map
*.d

# Directorios de build y de artefactos (raíz y por plataforma:
# platform/linux/build, platform/windows/dist, etc.)
build/
dist/
/out/

# Generados por mfstool (§26)
matrixfs_resources.h
rsc_certificate.txt
*.dict
*.signed

# Imágenes del simulador vFlash y trazas HCT
*.vflash
*.img
*.hct
*.cbor

# Material de clave: NUNCA comiteable (MFS-SEC-002, cero secretos en reposo)
*.pem
*.key
*.p8
*.p12
secrets/
keys/

# Entornos de desarrollo
.vscode/
.idea/
*.swp
*~

# CMake / Ninja (incluye los proyectos de prueba de las plataformas)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
.ninja_log
.ninja_deps
.ninja_lock
.cache/

# ESP-IDF: artefactos GENERADOS de un proyecto. OJO: sdkconfig.defaults SÍ es
# fuente y NO se ignora (aquí solo `sdkconfig` y `sdkconfig.old`).
managed_components/
dependencies.lock
sdkconfig
sdkconfig.old

# Python
__pycache__/
*.py[cod]

# SDKs y toolchains instalados LOCALMENTE para validación (ESP-IDF, ARM GCC,
# STM32Cube, venv): no se versionan. Ver DOCS/platform-optimization-report.md §9.
.tools/
